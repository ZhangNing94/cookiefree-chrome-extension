{
  "manifest_version": 3,
  "name": "CookieFree",
  "version": "1.0.0",
  "description": "Privacy cleaner: clear cookies, cache, history with scheduling and whitelist support",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "CookieFree"
  },
  "permissions": [
    "browsingData",
    "cookies",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}